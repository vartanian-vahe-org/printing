# Demo server settings. deploy/make-env.sh generates deploy/.env.demo with random secrets.
# deploy/.env.demo is git-ignored; never commit real values.

# Layout. All-in-one: storefront and admin run on the server too.
DEPLOY_MODE=all-in-one
COMPOSE_PROFILES=sites
CADDYFILE=Caddyfile
# Split (deploy/VERCEL.md): storefront and admin on Vercel. Use these instead of the three lines above.
#DEPLOY_MODE=split
#CADDYFILE=Caddyfile.backend
#WEB_URL=https://printing-web.vercel.app
#ADMIN_URL=https://printing-admin.vercel.app
# Origins allowed to upload straight to file storage (and to call the API from a browser).
#SITE_URLS=https://printing-web.vercel.app,https://printing-admin.vercel.app
# Shared with both Vercel projects: lets their /api proxy pass the visitor IP to the API.
#API_PROXY_SECRET=replace-me-long-random

# sslip.io gives an HTTPS-capable hostname for an IP: 1.2.3.4 -> 1-2-3-4.sslip.io
DOMAIN=1-2-3-4.sslip.io
# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=you@example.com

# Password that protects the demo site.
BASIC_AUTH_USER=demo
# bcrypt hash, single-quoted so `$` is not interpolated. Generate with:
#   docker run --rm caddy:2.11.7-alpine caddy hash-password --plaintext '<password>'
BASIC_AUTH_HASH='$2a$14$replace-me'

POSTGRES_USER=printing
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=printing

S3_BUCKET=printing-uploads
S3_REGION=us-west-1
S3_ACCESS_KEY_ID=printing-demo
S3_SECRET_ACCESS_KEY=replace-me

# Signs the private order links in emails. Changing it breaks links already sent.
ORDER_LINK_SECRET=replace-me-long-random

# Encrypts secrets kept in the database (admin two-step sign-in). Changing it turns 2FA off for everyone.
DATA_ENCRYPTION_KEY=replace-me-long-random

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-at-least-12-chars
ADMIN_NAME=Admin
