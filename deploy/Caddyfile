# Storefront demo, password protected. HTTPS certificates are issued automatically.
{$DOMAIN} {
	encode zstd gzip

	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Keep the demo out of search engines.
		X-Robots-Tag "noindex, nofollow"
	}

	reverse_proxy web:3000
}

# Emails sent by the demo (Mailpit), behind the same password.
mail.{$DOMAIN} {
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy mailpit:8025
}

# API: called by the browser from the storefront and the admin (CORS set in the API).
# No basic auth: browsers would not send it on these requests. Orders need their private token,
# the admin its own sign-in.
api.{$DOMAIN} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy api:4000
}

# Object storage for presigned uploads and downloads. The Host header is passed through
# unchanged, which the presigned signatures include.
files.{$DOMAIN} {
	header X-Robots-Tag "noindex, nofollow"
	request_body {
		max_size 60MB
	}
	reverse_proxy storage:9000
}

# Admin app, behind the demo password and its own sign-in.
admin.{$DOMAIN} {
	encode zstd gzip
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy admin:8080
}
