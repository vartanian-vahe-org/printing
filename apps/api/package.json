{
  "name": "@printing/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && concurrently --kill-others --names build,run \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --enable-source-maps --watch-path=dist --watch-path=../../packages/pricing/dist --watch-path=../../packages/db/dist --watch-path=../../packages/templates/dist dist/main.js\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@printing/db": "workspace:*",
    "@printing/pricing": "workspace:*",
    "@printing/templates": "workspace:*",
    "drizzle-orm": "~0.45.4",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@printing/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
