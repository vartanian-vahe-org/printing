# Copy to .env for local development: cp .env.example .env
# These values are for local Docker only. Never use them in production.

# --- Postgres ---
POSTGRES_USER=printing
POSTGRES_PASSWORD=printing
POSTGRES_DB=printing
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- S3-compatible storage (RustFS locally, AWS S3 in production) ---
S3_BUCKET=printing-uploads
S3_REGION=us-west-1
S3_ACCESS_KEY_ID=printing-dev
S3_SECRET_ACCESS_KEY=printing-dev-secret
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# --- Mailpit (catches outgoing email locally) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MAIL_FROM_ADDRESS=orders@printing.local

# --- Signs private order links in emails ---
ORDER_LINK_SECRET=dev-only-order-link-secret

# --- Encrypts secrets stored in the database (admin two-step sign-in keys) ---
DATA_ENCRYPTION_KEY=dev-only-data-encryption-key

# --- Shared by the sites' /api proxy (Vercel) and the API ---
API_PROXY_SECRET=dev-only-api-proxy-secret

# --- App ports on the host ---
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=5173

# --- First admin account (created by the migrate service if it does not exist) ---
ADMIN_EMAIL=admin@printing.local
ADMIN_PASSWORD=change-me-dev-only
ADMIN_NAME=Admin
